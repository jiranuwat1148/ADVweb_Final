# ตัวอย่างเท่านั้น; อย่าคัดลอกทับ .env เดิมที่เชื่อม Aiven ได้
DB_HOST=your-service.aivencloud.com
DB_PORT=19992
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=delivery_app
DB_CA_PATH=ca.pem
PORT=3000

# npm run auth:setup จะสร้างสองค่านี้โดยเก็บรหัสผ่านเป็น hash
OWNER_USERNAME=
OWNER_PASSWORD_HASH=
SESSION_TTL_SECONDS=28800

# ใส่พิกัดร้านจริง หรือส่ง shop ใน POST /api/plans
SHOP_LATITUDE=
SHOP_LONGITUDE=

# ใช้สำหรับ routing_mode=road เท่านั้น
OSRM_BASE_URL=https://router.project-osrm.org
